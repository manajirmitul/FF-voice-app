rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Put YOUR admin email here, all lowercase (the same account you use in admin.html)
    function isAdmin() {
      return request.auth != null
          && request.auth.token.email == 'PUT_YOUR_ADMIN_EMAIL_HERE';
    }

    // Payment requests: a user writes only their own, as "pending"
    match /requests/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.uid == uid
          && request.resource.data.status == 'pending'
          && request.resource.data.keys().hasOnly(
              ['uid','email','plan','months','amount','method','trx','status','createdAt']);
      allow update, delete: if isAdmin();
    }

    // Licenses: created and removed only by the admin.
    // A user may only start their own unactivated license, once, for at most its length.
    match /licenses/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
          request.auth != null
          && request.auth.uid == uid
          && resource.data.activatedAt == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activatedAt','expiresAt'])
          && request.resource.data.expiresAt <= request.time + duration.value(resource.data.days + 1, 'd'));
    }
  }
}
