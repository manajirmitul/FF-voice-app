<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_panel">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="প্রিমিয়াম সাবস্ক্রিপশন প্ল্যান"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"/>

    <!-- ১ মাস প্ল্যান কার্ড -->
    <LinearLayout
        android:id="@+id/card1Month"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_card"
        android:clickable="true"
        android:focusable="true">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="১ মাস সাবস্ক্রিপশন"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="মেয়াদ: ৩০ দিন"
                android:textSize="12sp"
                android:textColor="#AAAAAA"/>
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="১০০ টাকা"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#4CAF50"
            android:layout_gravity="center_vertical"/>
    </LinearLayout>

    <!-- ৩ মাস প্ল্যান কার্ড -->
    <LinearLayout
        android:id="@+id/card3Month"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_card"
        android:clickable="true"
        android:focusable="true">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="৩ মাস সাবস্ক্রিপশন"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="মেয়াদ: ৯০ দিন"
                android:textSize="12sp"
                android:textColor="#AAAAAA"/>
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="২০০ টাকা"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#4CAF50"
            android:layout_gravity="center_vertical"/>
    </LinearLayout>

    <!-- ১২ মাস প্ল্যান কার্ড -->
    <LinearLayout
        android:id="@+id/card12Month"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_card"
        android:clickable="true"
        android:focusable="true">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="১২ মাস (১ বছর) সাবস্ক্রিপশন"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="মেয়াদ: ৩৬৫ দিন (সেরা অফার)"
                android:textSize="12sp"
                android:textColor="#AAAAAA"/>
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="৫০০ টাকা"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#4CAF50"
            android:layout_gravity="center_vertical"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnAlreadyHaveKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="আগে থেকেই Key আছে? এখানে বসান"
        android:textColor="#00BCD4"
        android:background="@android:color/transparent"/>

</LinearLayout>
